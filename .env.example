# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here

# Express Web Server Configuration
PORT=3000
# The public URL where the web server is accessible (used for OAuth2 redirect)
# E.g., http://localhost:3000 or https://yourdomain.com
BASE_URL=http://localhost:3000
REDIRECT_URI=http://localhost:3000/auth/callback

# Security Settings
# API Key from https://proxycheck.io/ (optional, bot will use a mock fallback if left empty or 'mock')
PROXYCHECK_API_KEY=mock

# Alt Account Detection
# Number of maximum Discord accounts allowed to verify from the same IP address
ALT_LIMIT=1

# Secret key for generating secure verification tokens/session signatures (min 32 characters recommended)
SESSION_SECRET=a_very_long_random_string_for_signing_cookies_and_sessions_12345
